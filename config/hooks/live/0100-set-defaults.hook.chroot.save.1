#!/bin/bash
set -e

echo "=== Setting XFCE Defaults ==="

# Ensure backgrounds directory exists
mkdir -p /usr/share/backgrounds

# Verify wallpaper file exists
if [ -f /usr/share/backgrounds/default-wallpaper.png ]; then
    echo "✓ Wallpaper found!"
    WALLPAPER="/usr/share/backgrounds/default-wallpaper.png"
else
    echo "✗ WARNING: Custom wallpaper not found, using Debian default"
    WALLPAPER="/usr/share/images/desktop-base/desktop-grub.png"
fi

# Create XFCE config directory
SKEL_XFCE="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SKEL_XFCE"

# Set wallpaper for all users
cat > "$SKEL_XFCE/xfce4-desktop.xml" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="$WALLPAPER"/>
        </property>
      </property>
      <property name="monitorVirtual1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="$WALLPAPER"/>
        </property>
      </property>
    </proper  </property>
  </property>
  </property>
  </property>
  </property>
</channel>
EOF
# Set XFCE Terminal black + neon cyan theme
TERM_CONFIG="/etc/skel/.config/xfce4/terminal"
mkdir -p "$TERM_CONFIG"
cat > "$TERM_CONFIG/terminalrc" << 'TERMEOF'
[Configuration]
ColorBackground=#000000
ColorForeground=#00FFFF
ColorPalette=#000000;#FF0000;#00FF00;#FFFF00;#0080FF;#FF00FF;#00FFFF;#FFFFFF;#808080;#FF6060;#60FF60;#FFFF60;#60A0FF;#FF60FF;#60FFFF;#FFFFFF
FontName=Monospace 11
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
ScrollingLines=10000
TERMEOF

# Enable tab autocomplete + history search
cat >> /etc/skel/.bashrc << 'BASHEOF'
if [ -f /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
fi
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward' 2>/dev/null
BASHEOF
chmod 644 "$SKEL_XFCE"/*.xml
# Ensure bashrc is executable and will run
chmod 644 /etc/skel/.bashrc

echo "✓ Bash configuration applied"

echo "=== XFCE defaults configured ==="
echo "Wallpaper set to: $WALLPAPER"
echo "=== Setting Custom Boot Screen ==="
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/cyscom/cyscom.plymouth 100
update-alternatives --set default.plymouth /usr/share/plymouth/themes/cyscom/cyscom.plymouth
echo "✓ Plymouth configured"


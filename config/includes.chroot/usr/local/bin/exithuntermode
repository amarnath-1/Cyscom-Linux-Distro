#!/bin/bash

clear
echo ""
echo -e "\e[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo -e "\e[1;36m        Returning to Cyscom normal mode...        \e[0m"
echo -e "\e[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo ""

# Restore original bashrc
if [ -f /tmp/.bashrc.normal ]; then
    cp /tmp/.bashrc.normal ~/.bashrc
    echo -e "\e[1;36m  ✅ Profile restored\e[0m"
else
    echo -e "\e[1;33m  ⚠ No saved profile found\e[0m"
fi

source ~/.bashrc 2>/dev/null
echo -e "\e[1;36m  ✅ Back to Cyscom normal mode\e[0m"
echo -e "\e[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo ""

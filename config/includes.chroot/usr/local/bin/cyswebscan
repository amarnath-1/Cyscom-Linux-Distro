#!/bin/bash
if [ -z "$1" ]; then
    echo "Usage: cyswebscan <url>"
    echo "Example: cyswebscan example.com"
    exit 1
fi
URL=$1
echo "════════════════════════════════════════════════════════"
echo "🔵 Cyscom Web Security Scanner"
echo "════════════════════════════════════════════════════════"
echo "Target: $URL"
echo "Started: $(date)"
echo "════════════════════════════════════════════════════════"
echo ""
echo "[1/5] 📋 Analyzing HTTP Headers..."
curl -I https://$URL 2>/dev/null | head -15
echo ""
echo "[2/5] 🔒 Checking SSL/TLS Configuration..."
echo | openssl s_client -connect $URL:443 2>/dev/null | grep -E "Protocol|Cipher"
echo ""
echo "[3/5] 🌐 Checking DNS Records..."
dig $URL +short
echo ""
echo "[4/5] 📁 Scanning for common directories..."
for dir in admin login api test backup; do
    STATUS=$(curl -o /dev/null -s -w "%{http_code}" https://$URL/$dir)
    echo "/$dir - HTTP $STATUS"
done
echo ""
echo "[5/5] 🔍 Detecting Web Technologies..."
curl -s https://$URL | grep -oE "<meta.*>" | head -5
echo ""
echo "════════════════════════════════════════════════════════"
echo "✅ Web scan complete!"
echo "⚠️  Get permission before scanning!"
echo "════════════════════════════════════════════════════════"

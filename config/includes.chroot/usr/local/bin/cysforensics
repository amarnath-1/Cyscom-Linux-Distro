#!/bin/bash
if [ -z "$1" ]; then
    echo "Usage: cysforensics <file>"
    exit 1
fi
FILE=$1
if [ ! -f "$FILE" ]; then
    echo "Error: File not found!"
    exit 1
fi
echo "════════════════════════════════════════════════════════"
echo "🔵 Cyscom Forensics Analyzer"
echo "════════════════════════════════════════════════════════"
echo "Target: $FILE"
echo "════════════════════════════════════════════════════════"
echo ""
echo "[1/5] 🔍 Extracting metadata..."
exiftool "$FILE" 2>/dev/null || echo "exiftool not available"
echo ""
echo "[2/5] 📦 Searching for hidden files..."
binwalk "$FILE" 2>/dev/null || echo "binwalk not available"
echo ""
echo "[3/5] 🔎 Scanning for strings..."
strings "$FILE" | head -50
echo ""
echo "[4/5] 🎭 Hex dump..."
xxd "$FILE" | tail -20
echo ""
echo "[5/5] 📊 File info..."
file "$FILE"
echo ""
echo "════════════════════════════════════════════════════════"
echo "✅ Forensics complete!"
echo "════════════════════════════════════════════════════════"

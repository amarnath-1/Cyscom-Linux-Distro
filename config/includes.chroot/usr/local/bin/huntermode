#!/bin/bash
cp ~/.bashrc /tmp/.bashrc.normal 2>/dev/null
clear
echo ""
echo -e "\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo -e "\e[1;35m        ⚔  I AM THE HUNTER — ARISE  ⚔          \e[0m"
echo -e "\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo ""
echo -e "\e[0;35m  ⚡ SYSTEM INTEL:\e[0m"
echo -e "\e[1;35m  CPU  :\e[0m $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)"
echo -e "\e[1;35m  RAM  :\e[0m $(free -h | awk '/^Mem:/ {print $3 " used / " $2 " total"}')"
echo -e "\e[1;35m  DISK :\e[0m $(df -h / | awk 'NR==2 {print $3 " used / " $2 " total"}')"
echo -e "\e[1;35m  IP   :\e[0m $(hostname -I | awk '{print $1}')"
echo ""
echo -e "\e[0;35m  🌐 NETWORK:\e[0m"
ip -br addr show 2>/dev/null | awk '{printf "  \033[1;35m%-10s\033[0m %s\n", $1, $3}' | head -5
echo ""
echo -e "\e[0;35m  📊 TOP PROCESSES:\e[0m"
ps aux --sort=-%cpu | awk 'NR>=2 && NR<=5 {printf "  \033[1;35m%-20s\033[0m CPU: %s%%\n", $11, $3}' 2>/dev/null
echo ""
echo -e "\e[0;35m  🗡  WEAPONS:\e[0m"
echo -e "\e[1;35m  cysforensics  cysstego  cyscrypto  cysnetscan  cyswebscan\e[0m"
echo ""
echo -e "\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo -e "\e[0;35m  Type \e[1;35mexithuntermode\e[0;35m to return to normal\e[0m"
echo -e "\e[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
echo ""

# Change terminal colors to TRUE BLACK + purple via xfconf
xfconf-query -c xfce4-terminal -p /color-background -s "#000000" 2>/dev/null
xfconf-query -c xfce4-terminal -p /color-foreground -s "#CC00FF" 2>/dev/null

cat >> ~/.bashrc << 'PROMPTEOF'
export PS1='\[\e[1;35m\]⚔ HUNTER\[\e[0;35m\]@\[\e[1;35m\]\h\[\e[0;35m\]:\[\e[1;35m\]\w\[\e[0;35m\] → \[\e[0m\]'
PROMPTEOF
source ~/.bashrc 2>/dev/null

[global_config]
  title_hide_sizetext = True
  title_transmit_bg_color = "#0a1628"
  
[keybindings]

[profiles]
  [[default]]
    background_color = "#0a1628"
    background_darkness = 0.95
    background_type = solid
    cursor_color = "#00d9ff"
    cursor_shape = ibeam
    font = Monospace 11
    foreground_color = "#00d9ff"
    palette = "#0a1628:#ff5555:#50fa7b:#f1fa8c:#00d9ff:#bd93f9:#8be9fd:#f8f8f2:#0a1628:#ff6e6e:#69ff94:#ffffa5:#00e1ff:#d6acff:#a4ffff:#ffffff"
    scrollback_infinite = True
    scrollbar_position = hidden
    use_system_font = False
    
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0

[plugins]
